{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"assignees": ["almeidx"],
	"commitMessagePrefix": "deps:",
	"extends": ["config:recommended"],
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["* 0-8 * * 6"]
	},
	"minimumReleaseAge": "1 day",
	"packageRules": [
		{
			"description": "Keep GTK on 0.18 until tray-icon's GTK dependencies support 0.19; gtk-sys versions cannot share links = gtk-3.",
			"matchManagers": ["cargo"],
			"matchPackageNames": ["gtk"],
			"allowedVersions": "<0.19"
		},
		{
			"groupName": "patch/minor dependencies",
			"groupSlug": "all-non-major",
			"matchUpdateTypes": ["patch", "minor"],
			"schedule": ["* 0-8 * * 6"]
		}
	],
	"prHourlyLimit": 0,
	"rangeStrategy": "bump",
	"schedule": ["* 0-8 * * 6"],
	"timezone": "Europe/Lisbon"
}
